# FinSec Agent Backend Environment Variables
# Copy this file to .env and fill in your credentials.

# Public API Key for /v1/* endpoints (X-API-Key header)
FINSEC_API_KEY=finsec-demo-key-2026

# Database mode: leave SUPABASE_URL empty to automatically use local SQLite (finsec_local.db)
# Fill both to connect to production Supabase (PostgreSQL)
SUPABASE_URL=
SUPABASE_KEY=

# LLM Provider for AI SOC Agent ReAct loop (Gemini preferred, OpenAI optional)
# If neither key is provided or API times out, the deterministic SOC fallback engine runs automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_TOTAL_BUDGET_SECONDS=40
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS allowed origins (comma-separated or *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
